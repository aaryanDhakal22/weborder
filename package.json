{
  "name": "quicc-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant customer ordering websites for quicc stores: SSR + static snapshots, mock API, admin store builder.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:e2e": "vite build && node --test \"test/e2e/*.test.ts\"",
    "sync-engine": "node scripts/sync-engine.ts",
    "fonts": "node scripts/fetch-fonts.ts",
    "store": "node scripts/store.ts",
    "shots": "node scripts/screenshots.ts",
    "export": "node scripts/export-static.ts",
    "perf": "node scripts/perf.ts",
    "test:browser": "vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
